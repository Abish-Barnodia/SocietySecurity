generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id               String            @id @default(cuid())
  name             String
  address          String
  city             String
  pincode          String
  totalUnits       Int
  totalTowers      Int               @default(1)
  residentParkingSlots Int           @default(0)
  visitorParkingSlots  Int           @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  amenities        Amenity[]
  parkingSlots     ParkingSlot[]
  broadcasts       Broadcast[]
  chatMessages     ChatMessage[]
  complaints       Complaint[]
  entryPoints      EntryPoint[]
  escalationChains EscalationChain[]
  guards           Guard[]
  incidents        Incident[]
  invoices         Invoice[]
  managers         Manager[]
  units            Unit[]
  events           Event[]
  fundTransactions FundTransaction[]
}

model EntryPoint {
  id         String      @id @default(cuid())
  propertyId String
  name       String
  type       String
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  entries    Entry[]
  property   Property    @relation(fields: [propertyId], references: [id])
  guards     GuardPost[]
}

model Unit {
  id              String           @id @default(cuid())
  propertyId      String
  unitNumber      String
  floor           Int
  tower           String?
  familyName      String?
  isOccupied      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  complaints      Complaint[]
  domesticWorkers DomesticWorker[]
  entries         Entry[]
  incidents       Incident[]
  invoices        Invoice[]
  passes          Pass[]
  residents       Resident[]
  property        Property         @relation(fields: [propertyId], references: [id])
  vehicles        Vehicle[]

  @@unique([propertyId, unitNumber])
}

model User {
  id              String           @id @default(cuid())
  phone           String?          @unique
  email           String?          @unique
  isEmailVerified Boolean          @default(false)
  passwordHash    String?
  role            Role
  fcmTokens       String[]         @default([])
  isActive        Boolean          @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  auditLogs       AuditLog[]
  chatMessages    ChatMessage[]
  chatPollVotes   ChatPollVote[]
  chatReactions   ChatReaction[]
  chatReports     ChatReport[]
  committee       CommitteeMember?
  escalationSteps EscalationStep[]
  guard           Guard?
  manager         Manager?
  otps            OTP[]
  refreshTokens   RefreshToken[]
  resident        Resident?
}

model Resident {
  id                   String           @id @default(cuid())
  userId               String           @unique
  unitId               String
  name                 String
  isPrimary            Boolean          @default(false)
  emergencyContact     String?
  emergencyContactName String?
  alertPreferences     Json             @default("{}")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  showUnitInCommunity  Boolean          @default(true)
  residentType         String           @default("Owner")
  mutedFromCommunity   Boolean          @default(false)
  relationship         String           @default("Primary")
  complaints           Complaint[]
  registeredWorkers    DomesticWorker[]
  invoices             Invoice[]
  passes               Pass[]
  unit                 Unit             @relation(fields: [unitId], references: [id])
  user                 User             @relation(fields: [userId], references: [id])
  walkinApprovals      WalkinApproval[]
  eventRSVPs           EventRSVP[]
}

model Guard {
  id           String       @id @default(cuid())
  userId       String       @unique
  propertyId   String
  name         String
  badgeNumber  String       @unique
  isOnDuty     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  entries      Entry[]
  property     Property     @relation(fields: [propertyId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  postCheckIns GuardPost[]
  incidents    Incident[]
  shifts       Shift[]
  leaves       GuardLeave[]
  salaries     GuardSalary[]
}

model Manager {
  id               String   @id @default(cuid())
  userId           String   @unique
  propertyId       String
  name             String
  alertPreferences Json     @default("{}")
  createdAt        DateTime @default(now())
  property         Property @relation(fields: [propertyId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
}

model CommitteeMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  role      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model OTP {
  id        String    @id @default(cuid())
  userId    String
  code      String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Pass {
  id             String             @id @default(cuid())
  residentId     String
  unitId         String
  type           PassType
  status         PassStatus         @default(ACTIVE)
  visitorName    String
  visitorPhone   String?
  visitorPhoto   String?
  purpose        String?
  qrPayload      String?
  otpCode        String?
  validFrom      DateTime
  validUntil     DateTime
  entryPointIds  String[]           @default([])
  suspendedAt    DateTime?
  suspendedUntil DateTime?
  revokedAt      DateTime?
  revokedBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  entries        Entry[]
  resident       Resident           @relation(fields: [residentId], references: [id])
  unit           Unit               @relation(fields: [unitId], references: [id])
  usageHistory   PassUsageHistory[]
  recurringRule  RecurringRule?
}

model RecurringRule {
  id              String      @id @default(cuid())
  passId          String      @unique
  allowedDays     DayOfWeek[]
  windowStartTime String
  windowEndTime   String
  createdAt       DateTime    @default(now())
  pass            Pass        @relation(fields: [passId], references: [id])
}

model PassUsageHistory {
  id      String   @id @default(cuid())
  passId  String
  entryId String?
  usedAt  DateTime @default(now())
  outcome String
  entry   Entry?   @relation(fields: [entryId], references: [id])
  pass    Pass     @relation(fields: [passId], references: [id])
}

model Entry {
  id             String             @id @default(cuid())
  unitId         String
  passId         String?
  guardId        String
  entryPointId   String
  visitorName    String
  visitorPhone   String?
  vehicleNumber  String?
  method         EntryMethod
  status         EntryStatus
  gatePhotoUrl   String?
  notes          String?
  entryAt        DateTime           @default(now())
  exitAt         DateTime?
  createdAt      DateTime           @default(now())
  alerts         Alert[]
  entryPoint     EntryPoint         @relation(fields: [entryPointId], references: [id])
  guard          Guard              @relation(fields: [guardId], references: [id])
  pass           Pass?              @relation(fields: [passId], references: [id])
  unit           Unit               @relation(fields: [unitId], references: [id])
  usageHistory   PassUsageHistory[]
  walkinApproval WalkinApproval?
  parkingSlot    ParkingSlot?
}

model WalkinApproval {
  id            String    @id @default(cuid())
  entryId       String    @unique
  residentId    String
  visitorName   String
  purpose       String
  requestedAt   DateTime  @default(now())
  respondedAt   DateTime?
  decision      String?
  timeoutAt     DateTime
  guardCalledAt DateTime?
  createdAt     DateTime  @default(now())
  entry         Entry     @relation(fields: [entryId], references: [id])
  resident      Resident  @relation(fields: [residentId], references: [id])
}

model Alert {
  id              String        @id @default(cuid())
  entryId         String?
  incidentId      String?
  propertyId      String
  priority        AlertPriority
  status          AlertStatus   @default(SENT)
  title           String
  body            String
  targetRoles     Role[]
  targetUserIds   String[]
  channel         AlertChannel
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  escalatedAt     DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  claimedAt       DateTime?
  claimedByName   String?
  claimedByUserId String?
  imageUrl        String?
  escalationStep  Int           @default(0)
  entry           Entry?        @relation(fields: [entryId], references: [id])
  incident        Incident?     @relation(fields: [incidentId], references: [id])
}

model EscalationChain {
  id         String           @id @default(cuid())
  propertyId String
  priority   AlertPriority
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  property   Property         @relation(fields: [propertyId], references: [id])
  steps      EscalationStep[]

  @@unique([propertyId, priority])
}

model EscalationStep {
  id           String            @id @default(cuid())
  chainId      String
  order        Int
  roleLabel    String
  userId       String?
  contactName  String?
  contactPhone String?
  delayMinutes Int
  channel      EscalationChannel
  createdAt    DateTime          @default(now())
  chain        EscalationChain   @relation(fields: [chainId], references: [id])
  user         User?             @relation(fields: [userId], references: [id])

  @@index([chainId])
}

model Incident {
  id             String           @id @default(cuid())
  propertyId     String
  unitId         String?
  guardId        String
  type           IncidentType
  status         IncidentStatus   @default(OPEN)
  description    String
  location       String
  photoUrls      String[]         @default([])
  vehicleNumber  String?
  assignedTo     String?
  assignedAt     DateTime?
  closedAt       DateTime?
  closedBy       String?
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  alerts         Alert[]
  guard          Guard            @relation(fields: [guardId], references: [id])
  property       Property         @relation(fields: [propertyId], references: [id])
  unit           Unit?            @relation(fields: [unitId], references: [id])
  actions        IncidentAction[]
}

model IncidentAction {
  id         String   @id @default(cuid())
  incidentId String
  actorId    String
  actorRole  Role
  action     String
  note       String?
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id])
}

model Vehicle {
  id             String   @id @default(cuid())
  unitId         String
  registrationNo String
  make           String?
  model          String?
  color          String?
  isResident     Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  unit           Unit     @relation(fields: [unitId], references: [id])

  @@unique([unitId, registrationNo])
}

model ParkingSlot {
  id         String   @id @default(cuid())
  propertyId String
  zone       String
  code       String
  entryId    String?  @unique
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  entry      Entry?   @relation(fields: [entryId], references: [id])

  @@unique([propertyId, code])
}

model Amenity {
  id         String           @id @default(cuid())
  propertyId String
  name       String
  capacity   Int
  status     AmenityStatus    @default(AVAILABLE)
  openTime   String
  closeTime  String
  createdAt  DateTime         @default(now())
  property   Property         @relation(fields: [propertyId], references: [id])
  bookings   AmenityBooking[]
}

model AmenityBooking {
  id         String   @id @default(cuid())
  amenityId  String
  residentId String
  date       DateTime
  startTime  String
  endTime    String
  status     String   @default("CONFIRMED")
  createdAt  DateTime @default(now())
  amenity    Amenity  @relation(fields: [amenityId], references: [id])
}

model Shift {
  id               String      @id @default(cuid())
  guardId          String
  startedAt        DateTime    @default(now())
  endedAt          DateTime?
  totalEntries     Int         @default(0)
  totalIncidents   Int         @default(0)
  openItems        String?
  handoverNote     String?
  signedOffAt      DateTime?
  createdAt        DateTime    @default(now())
  handedOverToId   String?
  handedOverToName String?
  postCheckIns     GuardPost[]
  guard            Guard       @relation(fields: [guardId], references: [id])
}

model GuardPost {
  id           String     @id @default(cuid())
  guardId      String
  shiftId      String
  entryPointId String
  checkedInAt  DateTime   @default(now())
  latitude     Float?
  longitude    Float?
  entryPoint   EntryPoint @relation(fields: [entryPointId], references: [id])
  guard        Guard      @relation(fields: [guardId], references: [id])
  shift        Shift      @relation(fields: [shiftId], references: [id])
}

model Broadcast {
  id          String   @id @default(cuid())
  propertyId  String
  sentBy      String
  title       String
  body        String
  targetScope String
  sentAt      DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Invoice {
  id          String        @id @default(cuid())
  propertyId  String
  unitId      String
  residentId  String?
  amount      Float
  description String
  dueDate     DateTime
  status      InvoiceStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  property    Property      @relation(fields: [propertyId], references: [id])
  resident    Resident?     @relation(fields: [residentId], references: [id])
  unit        Unit          @relation(fields: [unitId], references: [id])
  payments    Payment[]
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  amount          Float
  method          String
  transactionId   String?  @unique
  razorpayOrderId String?  @unique
  status          String
  paidAt          DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
}

model ChatMessage {
  id               String          @id @default(cuid())
  propertyId       String
  senderId         String
  type             ChatMessageType
  body             String?
  mediaUrl         String?
  mediaMimeType    String?
  mediaDurationSec Int?
  fileName         String?
  fileSizeBytes    Int?
  mentionedUserIds String[]        @default([])
  replyToId        String?
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  property         Property        @relation(fields: [propertyId], references: [id])
  replyTo          ChatMessage?    @relation("MessageReplies", fields: [replyToId], references: [id])
  replies          ChatMessage[]   @relation("MessageReplies")
  sender           User            @relation(fields: [senderId], references: [id])
  poll             ChatPoll?
  reactions        ChatReaction[]
  reports          ChatReport[]

  @@index([propertyId, createdAt])
}

model ChatReport {
  id         String       @id @default(cuid())
  messageId  String
  reporterId String
  reason     String
  status     ReportStatus @default(PENDING)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime     @default(now())
  message    ChatMessage  @relation(fields: [messageId], references: [id])
  reporter   User         @relation(fields: [reporterId], references: [id])

  @@index([messageId])
}

model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
}

model ChatPoll {
  id            String           @id @default(cuid())
  messageId     String           @unique
  question      String
  allowMultiple Boolean          @default(false)
  createdAt     DateTime         @default(now())
  message       ChatMessage      @relation(fields: [messageId], references: [id])
  options       ChatPollOption[]
}

model ChatPollOption {
  id     String         @id @default(cuid())
  pollId String
  text   String
  order  Int
  poll   ChatPoll       @relation(fields: [pollId], references: [id])
  votes  ChatPollVote[]
}

model ChatPollVote {
  id        String         @id @default(cuid())
  optionId  String
  userId    String
  createdAt DateTime       @default(now())
  option    ChatPollOption @relation(fields: [optionId], references: [id])
  user      User           @relation(fields: [userId], references: [id])

  @@unique([optionId, userId])
}

model Complaint {
  id             String            @id @default(cuid())
  propertyId     String
  unitId         String
  residentId     String
  category       ComplaintCategory
  priority       ComplaintPriority @default(MEDIUM)
  status         ComplaintStatus   @default(OPEN)
  title          String
  description    String
  attachmentUrls String[]          @default([])
  assignedTo     String?
  assignedToName String?
  assignedAt     DateTime?
  resolutionNote String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  property       Property          @relation(fields: [propertyId], references: [id])
  resident       Resident          @relation(fields: [residentId], references: [id])
  unit           Unit              @relation(fields: [unitId], references: [id])
  updates        ComplaintUpdate[]

  @@index([propertyId, createdAt])
  @@index([residentId, createdAt])
}

model ComplaintUpdate {
  id          String    @id @default(cuid())
  complaintId String
  actorId     String
  actorRole   Role
  action      String
  note        String?
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id])
}

model DomesticWorker {
  id             String      @id @default(cuid())
  unitId         String
  registeredById String
  name           String
  phone          String
  type           WorkerType
  address        String?
  photoUrl       String?
  govtIdType     String?
  govtIdNumber   String?
  workingDays    DayOfWeek[]
  entryTime      String
  exitTime       String
  notes          String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  registeredBy   Resident    @relation(fields: [registeredById], references: [id])
  unit           Unit        @relation(fields: [unitId], references: [id])
}

enum EscalationChannel {
  PUSH
  SMS
  EMAIL
  ALL
}

enum ReportStatus {
  PENDING
  DISMISSED
  RESOLVED
}

enum Role {
  RESIDENT
  GUARD
  MANAGER
  COMMITTEE
}

enum PassType {
  ONE_TIME
  RECURRING
  DELIVERY
  CONTRACTOR
}

enum PassStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum EntryMethod {
  QR_SCAN
  OTP
  MANUAL_GUARD
  VEHICLE_ANPR
}

enum EntryStatus {
  APPROVED
  DENIED
  PENDING_APPROVAL
  NO_RESPONSE
}

enum AlertPriority {
  P1
  P2
  P3
}

enum AlertStatus {
  SENT
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
}

enum AlertChannel {
  PUSH
  SMS
  EMAIL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum IncidentType {
  UNREGISTERED_VEHICLE
  TAILGATING
  SUSPICIOUS_PERSON
  PERIMETER_BREACH
  UNAUTHORIZED_ACCESS
  PHYSICAL_ALTERCATION
  THEFT
  VANDALISM
  OTHER
}

enum AmenityStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ChatMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  POLL
}

enum ComplaintCategory {
  MAINTENANCE
  SECURITY
  NOISE
  PARKING
  CLEANLINESS
  BILLING
  STAFF_BEHAVIOR
  AMENITY
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum WorkerType {
  MAID
  COOK
  DRIVER
  NANNY
  ELECTRICIAN
  PLUMBER
  GARDENER
  SECURITY_GUARD
  OTHER
}

model Event {
  id          String   @id @default(cuid())
  propertyId  String
  title       String
  description String
  location    String?
  startDate   DateTime
  endDate     DateTime
  organizerId String?
  status      String   @default("UPCOMING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id])
  rsvps       EventRSVP[]
}

model EventRSVP {
  id         String   @id @default(cuid())
  eventId    String
  residentId String
  status     String   @default("GOING") // GOING, MAYBE, DECLINED
  createdAt  DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id])
  resident   Resident @relation(fields: [residentId], references: [id])

  @@unique([eventId, residentId])
}

model FundTransaction {
  id          String   @id @default(cuid())
  propertyId  String
  amount      Float
  type        String   // INCOME, EXPENSE
  category    String?
  description String?
  date        DateTime @default(now())
  recordedById String?
  createdAt   DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id])
}

model GuardLeave {
  id          String   @id @default(cuid())
  guardId     String
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String   @default("APPROVED") // APPROVED | CANCELLED
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  guard       Guard    @relation(fields: [guardId], references: [id])

  @@index([guardId])
}

model GuardSalary {
  id              String    @id @default(cuid())
  guardId         String
  monthYear       String    // e.g. "2026-08"
  baseSalary      Float
  deductions      Float
  netAmount       Float
  status          String    @default("PENDING") // PENDING | PAID
  razorpayOrderId String?   @unique
  transactionId   String?   @unique
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  guard           Guard     @relation(fields: [guardId], references: [id])

  @@unique([guardId, monthYear])
}
